{
  "name": "bubble-journey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && node scripts/build-single.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:single": "playwright test --config playwright.single.config.ts",
    "package": "node scripts/package.mjs"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.9"
  }
}
